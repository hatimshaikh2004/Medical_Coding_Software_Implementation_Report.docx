# 1. Initialize local repository
git init

# 2. Stage the document file
git add Medical_Coding_Software_Implementation_Report.docx

# 3. Commit staged changes
git commit -m "Add Week 4 Medical Coding Implementation Report"

# 4. Set main branch
git branch -M main

# 5. Link to your GitHub repository
git remote add origin https://github.com/YOUR_USERNAME/YOUR_REPOSITORY_NAME.git

# 6. Push to GitHub
git push -u origin main
